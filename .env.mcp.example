# Credenciales del servidor MCP de PocketBase (herramienta de desarrollo).
# Copiá este archivo como .env.mcp en la raíz del proyecto. No se sube a Git ni va junto al .exe.
# La dirección de PocketBase se toma de MI_COTIZADOR_PB_URL en el archivo .env.
#
# Opción recomendada: un token de superusuario (no guarda tu contraseña y vence solo).
MI_COTIZADOR_MCP_TOKEN=
# Alternativa: email y contraseña de superusuario (se usa solo si el token está vacío).
MI_COTIZADOR_MCP_EMAIL=
MI_COTIZADOR_MCP_PASSWORD=
