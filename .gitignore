# Configuración local (se versiona solo .env.example)
.env

# Python
__pycache__/
*.pyc
.venv/

# Resultado de compilar el .exe (se regenera con PyInstaller)
dist/
build/
*.spec

# PocketBase: se versionan las migraciones (pb_migrations/), no el binario ni los datos
pocketbase/*
!pocketbase/pb_migrations/

# Datos del usuario generados por la app
historial.txt
